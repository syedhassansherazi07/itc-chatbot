    {
      "parameters": {
        "jsCode": "\nconst pages = [\n  { node: 'Fetch Clinic Profile', key: 'clinic_profile', title: 'ITC Immunity Therapy Center - Clinic Profile', url: 'https://www.placidway.com/profile/5/Alternative-Cancer-Treatment-by-ITC-Immunity-Therapy-Center' },\n  { node: 'Fetch Adenocarcinoma Package', key: 'adenocarcinoma_package', title: 'Alternative Adenocarcinoma Cancer Treatment Package in Tijuana', url: 'https://www.placidway.com/package/7903/Alternative-Adenocarcinoma-Cancer-Treatment-Package-in-Tijuana-Mexico-by-ITC' },\n  { node: 'Fetch Adrenal Package', key: 'adrenal_package', title: 'Alternative Adrenal Cancer Treatment Package in Tijuana', url: 'https://www.placidway.com/package/7902/Alternative-Adrenal-Cancer-Treatment-Package-in-Tijuana-Mexico-by-ITC' },\n  { node: 'Fetch Anal Package', key: 'anal_package', title: 'Alternative Anal Cancer Treatment Package in Tijuana', url: 'https://www.placidway.com/package/7901/Alternative-Anal-Cancer-Treatment-Package-in-Tijuana-Mexico-by-ITC' },\n  { node: 'Fetch Clinic Videos', key: 'clinic_videos', title: 'ITC Tijuana Videos - Alternative Cancer Treatment', url: 'https://www.placidway.com/profile-videos/5/Alternative-Cancer-Treatment-by-ITC-Immunity-Therapy-Center' },\n  { node: 'Fetch Price List', key: 'price_list', title: 'ITC Immunity Therapy Center - Price List', url: 'https://www.placidway.com/price-list/5/Alternative-Cancer-Treatment-by-ITC-Immunity-Therapy-Center' },\n  { node: 'Fetch Price Comparison 2026', key: 'price_comparison_2026', title: 'Alternative Medicine Cost Abroad - Compare Prices 2026', url: 'https://www.placidway.com/search-medical-pricings/Alternative-Medicine/All/1' },\n];\n\nconst MAX_CHARS = 20000;\nconst entities = { '&amp;': '&', '&lt;': '<', '&gt;': '>', '&quot;': '\"', '&#39;': \"'\", '&#x27;': \"'\", '&nbsp;': ' ', '&ndash;': '-', '&mdash;': '-', '&rsquo;': \"'\", '&lsquo;': \"'\", '&rdquo;': '\"', '&ldquo;': '\"' };\n\nfunction htmlToText(html) {\n  if (!html || typeof html !== 'string') return '';\n  const main = html.match(/<main[\\s\\S]*?<\\/main>/i);\n  let s = main ? main[0] : html;\n  s = s.replace(/<(script|style|noscript|svg|iframe|form|select)[\\s\\S]*?<\\/\\1>/gi, ' ');\n  s = s.replace(/<!--|-->/g, ' ');\n  s = s.replace(/<\\/(td|th)>/gi, ' | ');\n  s = s.replace(/<\\/(tr|p|div|li|h[1-6]|br)>|<br\\s*\\/?>/gi, '\\n');\n  s = s.replace(/<li[^>]*>/gi, '- ');\n  s = s.replace(/<[^>]+>/g, ' ');\n  s = s.replace(/&[#a-z0-9]+;/gi, (e) => entities[e] !== undefined ? entities[e] : ' ');\n  s = s.replace(/[{}]/g, ' ');\n  s = s.replace(/[ \\t]+/g, ' ').replace(/\\s*\\n\\s*/g, '\\n').replace(/\\n{2,}/g, '\\n').trim();\n  s = s.replace(/Request a video call[\\s\\S]*?Confirm Consultation/i, ' ').replace(/^.*\\(Pacific\\/Midway\\).*$/gm, ' ').trim();\n  return s.slice(0, MAX_CHARS);\n}\n\nconst refreshedAt = new Date().toISOString();\nconst out = [];\nfor (const p of pages) {\n  let html = '';\n  try { html = $(p.node).first().json.data; } catch (e) { html = ''; }\n  const content = htmlToText(html);\n  out.push({ json: { source_key: p.key, page_title: p.title, source_url: p.url, content: content || 'PAGE COULD NOT BE FETCHED ON LAST REFRESH', char_count: content.length, refreshed_at: refreshedAt } });\n}\nreturn out;\n"
      },
